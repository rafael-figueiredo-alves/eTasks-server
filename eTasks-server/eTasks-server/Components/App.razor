<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!-- SEO -->
    <meta name="description" content="eTasks Server – Gerencie suas tarefas com eficiência e organização." />
    <meta name="keywords" content="tarefas, gerenciamento, produtividade, etasks" />
    <meta name="author" content="Rafael de Figueiredo Alves" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:title" content="eTasks" />
    <meta property="og:description" content="Gerencie suas tarefas com eficiência e organização." />
    <meta property="og:image" content="/eTasks2.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="eTasks" />
    <meta name="twitter:description" content="Gerencie suas tarefas com eficiência e organização." />
    <meta name="twitter:image" content="/eTasks2.webp" />

    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["eTasks-server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/webp" href="eTasks2.webp" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>  
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
