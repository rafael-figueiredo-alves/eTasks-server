@page "/admin/server-settings"
@attribute [Authorize]
@using eTasks_server.Models.DTOs.ServerSettings.Requests
@rendermode InteractiveServer
@inherits ServerSettingsPage

<PageTitle>Configuracoes do Servidor</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-8">
    <AdminPageHeader Title="Configuracoes do Servidor"
                     Subtitle="Ajuste recursos operacionais do host sem reiniciar a aplicacao.">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Disabled="@_isBusy">
            Recarregar
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@_isBusy">
            Salvar
        </MudButton>
    </AdminPageHeader>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <MudAlert Severity="@_statusSeverity" Dense="true" Class="mb-4">@_statusMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <div>
                            <MudText Typo="Typo.h6">SMTP / E-mail</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Envio de e-mails transacionais e operacionais.</MudText>
                        </div>
                        <MudStack Row="true" Spacing="2">
                            <MudSwitch @bind-Value="_model.SmtpEnabled" Color="Color.Primary">Habilitado</MudSwitch>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Mail" OnClick="TestEmailAsync" Disabled="@_isBusy">
                                Testar SMTP
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SmtpHost" Label="Host SMTP" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int" @bind-Value="_model.SmtpPort" Label="Porta" Min="1" Max="65535" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="3" Class="d-flex align-center"><MudSwitch @bind-Value="_model.SmtpEnableSsl" Color="Color.Primary">SSL/TLS</MudSwitch></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SmtpUsername" Label="Usuario SMTP" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SmtpPassword" Label="Senha SMTP" InputType="InputType.Password" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SmtpFromEmail" Label="E-mail remetente" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SmtpFromName" Label="Nome do remetente" Immediate="true" /></MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <div>
                            <MudText Typo="Typo.h6">IA / OpenRouter</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Controle de disponibilidade, chave e modelo gratuito.</MudText>
                        </div>
                        <MudStack Row="true" Spacing="2">
                            <MudSwitch @bind-Value="_model.OpenRouterEnabled" Color="Color.Primary">Habilitado</MudSwitch>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Psychology" OnClick="TestOpenRouterAsync" Disabled="@_isBusy">
                                Testar OpenRouter
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                        O modelo deve ser gratuito e terminar com <code>:free</code>.
                    </MudAlert>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OpenRouterBaseUrl" Label="Base URL" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OpenRouterApiKey" Label="API Key" InputType="InputType.Password" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OpenRouterModel" Label="Modelo" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal" @bind-Value="_model.OpenRouterTemperature" Label="Temperatura" Min="0" Max="2" Step="0.1m" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int" @bind-Value="_model.OpenRouterMaxTokens" Label="Max tokens" Min="1" Max="32000" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OpenRouterSiteUrl" Label="Site URL (referer)" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OpenRouterAppName" Label="Nome do app" Immediate="true" /></MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <div>
                            <MudText Typo="Typo.h6">MongoDB Auditoria</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Persistencia opcional de logs operacionais da API.</MudText>
                        </div>
                        <MudStack Row="true" Spacing="2">
                            <MudSwitch @bind-Value="_model.MongoAuditEnabled" Color="Color.Primary">Habilitado</MudSwitch>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Storage" OnClick="TestMongoAsync" Disabled="@_isBusy">
                                Testar Mongo
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12"><MudTextField @bind-Value="_model.MongoAuditConnectionString" Label="Connection string" InputType="InputType.Password" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.MongoAuditDatabaseName" Label="Database" Immediate="true" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.MongoAuditCollectionName" Label="Collection" Immediate="true" /></MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>
