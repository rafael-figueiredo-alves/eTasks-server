@* Página de informações da versão do aplicativo Cliente *@

@rendermode InteractiveServer
@page "/version"
@attribute [Authorize]
@inherits VersionBase

@using eTasks_server.Models.Utils

<PageTitle>Informações da Versão | @Constants.AppTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    <MudContainer MaxWidth="MaxWidth.Medium">

        <AdminPageHeader Title="Informações da Versão do Aplicativo" Class="mb-4">
            <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Edit" OnClick="GoToEdit">Editar</MudButton>
        </AdminPageHeader>

        <MudForm Model="_model">
            @if (isLoading)
            {
                <MudSkeleton Height="40px" Class="mb-2" />
                <MudSkeleton Height="40px" Class="mb-2" />
                <MudSkeleton Height="40px" Class="mb-2" />
                <MudSkeleton Height="40px" />
            }
            else
            {
                <MudTextField @bind-Value="_model.AppVersion" Label="Versão do Aplicativo" Variant="Variant.Outlined" Class="mb-4" ReadOnly />
                <MudTextField @bind-Value="_model.DisplayVersion" Label="Versão de exibição" Variant="Variant.Outlined" Class="mb-4" ReadOnly />
                <MudTextField @bind-Value="_model.URL_APK" Label="URL de download do APK" Variant="Variant.Outlined" Class="mb-4" ReadOnly />
                <MudTextField @bind-Value="_model.URL_Win" Label="URL de download do Windows" Variant="Variant.Outlined" Class="mb-4" ReadOnly />
            }
        </MudForm>

    </MudContainer>

</MudContainer>



