@* Página de Registro de usuários administradores do servidor do eTasks *@

@using eTasks_server.Models.Utils

@page "/register"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout EmptyLayout

@inherits RegisterBase


<PageTitle>Cadastro Administrativo | @Constants.AppTitle</PageTitle>

<div class="login-wrapper">
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-grid"></div>

    <div class="login-container">
        <MudPaper Class="login-card" Elevation="0">
            <div class="logo-area">
                <div class="logo-placeholder">
                    <MudImage src="/eTasks2.webp" alt="eTasks-server Logo" Style="height: 72px; width: auto; object-fit: contain;" />
                </div>
                <MudText Typo="Typo.h5" Class="brand-name">@Constants.AppTitle</MudText>
                <MudText Typo="Typo.caption" Class="brand-tagline">Cadastro administrativo</MudText>
            </div>

            <div class="divider-line"></div>

            <form class="form-area" method="post" action="/api/v2/web-auth/register">
                <AntiforgeryToken />

                <MudText Typo="Typo.h6" Class="form-title">Criar administrador</MudText>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="login-alert">
                        @ErrorMessage
                    </MudAlert>
                }

                <MudTextField @bind-Value="_displayName"
                              Label="Nome para exibição"
                              Variant="Variant.Outlined"
                              AdornmentIcon="@Icons.Material.Filled.Badge"
                              Adornment="Adornment.Start"
                              AdornmentColor="Color.Primary"
                              Class="login-field"
                              FullWidth="true"
                              Placeholder="Administrador"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="_email"
                              Label="Usuário (e-mail)"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                              Adornment="Adornment.Start"
                              AdornmentColor="Color.Primary"
                              Class="login-field"
                              FullWidth="true"
                              Placeholder="admin@etasks.com"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="_password"
                              Label="Senha"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Adornment="Adornment.Start"
                              AdornmentColor="Color.Primary"
                              Class="login-field"
                              FullWidth="true"
                              Placeholder="••••••••"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="_adminKey"
                              Label="Chave administrativa"
                              Variant="Variant.Outlined"
                              InputType="@(_showAdminKey ? InputType.Text : InputType.Password)"
                              AdornmentIcon="@Icons.Material.Filled.Key"
                              Adornment="Adornment.Start"
                              AdornmentColor="Color.Primary"
                              Class="login-field"
                              FullWidth="true"
                              Placeholder="APIKEY_ADMIN"
                              Required="true"
                              Immediate="true" />

                <input type="hidden" name="DisplayName" value="@_displayName" />
                <input type="hidden" name="Email" value="@_email" />
                <input type="hidden" name="Password" value="@_password" />
                <input type="hidden" name="AdminKey" value="@_adminKey" />

                <div class="form-options">
                    <MudCheckBox @bind-Value="_showPassword" Label="Mostrar senha" Color="Color.Primary" Size="Size.Small" Class="remember-check" />
                    <MudCheckBox @bind-Value="_showAdminKey" Label="Mostrar chave" Color="Color.Primary" Size="Size.Small" Class="remember-check" />
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="login-button"
                           ButtonType="ButtonType.Submit"
                           OnClick="BeginSubmit"
                           Disabled="_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                        <span>Cadastrando...</span>
                    }
                    else
                    {
                        <span>Cadastrar administrador</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           Href="/login"
                           Class="secondary-link">
                    Voltar para login
                </MudButton>
            </form>
        </MudPaper>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0e1a;
        position: relative;
        overflow: hidden;
        font-family: 'Sora', 'Segoe UI', sans-serif;
    }

    .bg-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.18;
        pointer-events: none;
    }

    .bg-orb-1 {
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, #5b7cfa 0%, #3a4fd4 60%, transparent 100%);
        top: -120px;
        left: -100px;
    }

    .bg-orb-2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, #a259ff 0%, #6c2bd9 60%, transparent 100%);
        bottom: -80px;
        right: -60px;
    }

    .bg-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(91, 124, 250, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(91, 124, 250, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    .login-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 460px;
        padding: 16px;
    }

    .login-card {
        background: rgba(16, 22, 40, 0.82) !important;
        border: 1px solid rgba(91, 124, 250, 0.18) !important;
        border-radius: 20px !important;
        padding: 40px 36px 32px !important;
        backdrop-filter: blur(24px);
        box-shadow: 0 0 0 1px rgba(255,255,255,0.04), 0 24px 64px rgba(0,0,0,0.55), 0 0 40px rgba(91,124,250,0.08) !important;
    }

    .logo-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        margin-bottom: 28px;
    }

    .logo-placeholder {
        position: relative;
        width: 64px;
        height: 64px;
        margin-bottom: 4px;
    }

    .brand-name {
        color: #e8eeff !important;
        font-weight: 700 !important;
        letter-spacing: 0.02em;
    }

    .brand-tagline {
        color: #6875a0 !important;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-size: 0.68rem !important;
    }

    .divider-line {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(91,124,250,0.3), transparent);
        margin-bottom: 28px;
    }

    .form-title {
        color: #c8d4ff !important;
        font-weight: 600 !important;
        margin-bottom: 22px !important;
    }

    .login-alert {
        margin-bottom: 16px !important;
        border-radius: 10px !important;
    }

    .login-field {
        margin-bottom: 16px !important;
    }

        .login-field .mud-input-outlined .mud-input-outlined-border {
            border-color: rgba(91, 124, 250, 0.25) !important;
            border-radius: 10px !important;
        }

        .login-field .mud-input-outlined.mud-input-focused .mud-input-outlined-border {
            border-color: #5b7cfa !important;
        }

        .login-field label,
        .login-field input,
        .login-field .mud-input-adornment {
            color: #a5b4d4 !important;
        }

    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        gap: 8px;
    }

    .remember-check {
        color: #6875a0 !important;
        font-size: 0.82rem;
    }

    .login-button {
        background: linear-gradient(135deg, #4a6cf7 0%, #7c3aed 100%) !important;
        border-radius: 10px !important;
        height: 50px !important;
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        text-transform: none !important;
        margin-bottom: 10px !important;
    }

    .secondary-link {
        color: #a5b4d4 !important;
        text-transform: none !important;
    }
</style>

