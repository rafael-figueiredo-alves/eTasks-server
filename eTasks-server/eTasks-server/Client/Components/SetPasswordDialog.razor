@namespace eTasks_server.Client.Components
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">Defina a nova senha para este usuário. Ele será desconectado e precisará usar a nova senha.</MudText>
        <MudTextField T="string" @bind-Value="Password" Label="Nova Senha" 
                      InputType="InputType.Password" Variant="Variant.Outlined" 
                      Required="true" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(string.IsNullOrEmpty(Password))">Alterar Senha</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string? Password { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Password));
    private void Cancel() => MudDialog.Cancel();
}
