@* Este é o componente para exibir uma linha de métrica *@

@inherits MetricRowBase

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.body2">@Metric.Label</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Metric.Count (@Percent)</MudText>
</MudStack>

<MudProgressLinear Value="@PercentValue" Color="Color.Primary" Class="mb-3" />
