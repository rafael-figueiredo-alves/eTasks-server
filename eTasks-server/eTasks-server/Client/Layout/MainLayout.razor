@* Layout principal para a aplicação *@

@inherits MainLayoutBase

@implements IDisposable

@* Required *@
<MudThemeProvider Theme="MyCustomTheme" IsDarkMode="@UserState!.IsDarkTheme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<UserLogsDrawer />

<MudLayout>

    <AppBar />

    <!-- Conteúdo principal -->
    <MudMainContent Class="pa-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
