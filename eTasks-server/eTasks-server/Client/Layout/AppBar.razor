@* Componente de barra de aplicação *@

@inherits AppBarBase

@* Appbar da aplicação com o menu de usuário *@
<MudAppBar Elevation="3">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleDrawer" />

    <MudText Typo="Typo.h6">eTasks Server</MudText>

    <MudSpacer />

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/docs", true))"
               Class="d-none d-md-inline-flex">
        Docs
    </MudButton>

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/about"))"
               Class="d-none d-md-inline-flex">
        Sobre
    </MudButton>

    <MudIconButton Icon="@(UserState!.IsDarkTheme ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   Color="Color.Inherit"
                   OnClick="ToggleTheme"
                   Class="mx-2"
                   Title="@(UserState!.IsDarkTheme ? "Mudar para modo claro" : "Mudar para modo escuro")" />

    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="ml-4">
        <ActivatorContent>
            <div @onclick="@context.ToggleAsync" style="cursor: pointer; display: flex; align-items: center; color: white;">
                <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2">
                    @if (!string.IsNullOrEmpty(UserState.PhotoBase64))
                    {
                        <MudImage Src="@($"data:image/png;base64,{UserState.PhotoBase64}")" />
                    }
                    else
                    {
                        @(UserState.Name?[0].ToString().ToUpper() ?? "?")
                    }
                </MudAvatar>
                <MudText Typo="Typo.body2" Class="d-none d-sm-inline" Style="color: white !important;">
                    @(UserState.Name ?? "Usuário")
                </MudText>
                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="color: white;" />
            </div>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="@(() => NavigateTo("/admin/profile"))">Ver Perfil</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LockReset" OnClick="ChangePassword">Trocar Senha</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="Logout">Sair</MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudAppBar>

@* Menu lateral com os atalhos das funcionalidades *@
<MudDrawer @bind-Open="_drawerOpen"
           Elevation="1"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           Height="100vh"
           Width="350px">

    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="pa-4">
            eTasks Server
        </MudText>

        <MudDivider />

        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Início
        </MudNavLink>

        <MudNavLink Href="/admin/server-settings"
                    Icon="@Icons.Material.Filled.Settings">
            Configurações do Servidor
        </MudNavLink>

        <MudNavLink Href="/version"
                    Icon="@Icons.Material.Filled.Info">
            Gerenciar versionamento do App
        </MudNavLink>

        <MudNavLink Href="/admin/users"
                    Icon="@Icons.Material.Filled.People">
            Gerenciar Usuários
        </MudNavLink>


        <MudNavLink Href="/admin/database"
                    Icon="@Icons.Material.Filled.Storage">
            Banco de Dados
        </MudNavLink>

        <MudNavLink Href="/admin/notifications"
                    Icon="@Icons.Material.Filled.Notifications">
            Notificações
        </MudNavLink>

        <MudNavLink Href="/admin/logs"
                    Icon="@Icons.Material.Filled.Article">
            Logs
        </MudNavLink>

        <MudNavLink Href="/admin/operation-audit"
                    Icon="@Icons.Material.Filled.QueryStats">
            Auditoria MongoDB
        </MudNavLink>

        <MudNavLink Href="/admin/console"
                    Icon="@Icons.Material.Filled.Terminal">
            Console
        </MudNavLink>

        <MudNavGroup Icon="@Icons.Material.Filled.Games" Title="Gamificação" Expanded="false">
            <MudNavLink Href="/admin/bonus/rules" Icon="@Icons.Material.Filled.Rule">
                Regras de Bônus
            </MudNavLink>
            <MudNavLink Href="/admin/bonus/achievements" Icon="@Icons.Material.Filled.EmojiEvents">
                Conquistas
            </MudNavLink>
        </MudNavGroup>

        <MudDivider Class="my-2" />

        <MudNavLink Href="/api/v2/web-auth/logout?returnUrl=%2Flogin"
                    Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
            Sair
        </MudNavLink>
    </MudNavMenu>

</MudDrawer>
