@rendermode InteractiveServer
@inject NavigationManager Navigation

<MudAppBar Elevation="3">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleDrawer" />

    <MudText Typo="Typo.h6">eTasks Server</MudText>

    <MudSpacer />

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/docs"))">
        Docs
    </MudButton>

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/about"))">
        Sobre
    </MudButton>
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen"
           Elevation="1"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           Height="100vh"
           Width="350px">

    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="pa-4">
            eTasks Server
        </MudText>

        <MudDivider />

        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Início
        </MudNavLink>

        <MudNavLink Href="/version"
                    Icon="@Icons.Material.Filled.Info">
            Gerenciar versionamento do App
        </MudNavLink>

        <MudNavLink Href="/admin/users"
                    Icon="@Icons.Material.Filled.People">
            Gerenciar Usuários
        </MudNavLink>

        <MudNavGroup Title="🎮 Gamificação" Expanded="false">
            <MudNavLink Href="/admin/bonus/rules" Icon="@Icons.Material.Filled.Rule">
                Regras de Bônus
            </MudNavLink>
            <MudNavLink Href="/admin/bonus/achievements" Icon="@Icons.Material.Filled.EmojiEvents">
                Conquistas
            </MudNavLink>
        </MudNavGroup>

        <MudDivider Class="my-2" />

        <MudNavLink Href="/api/v2/web-auth/logout?returnUrl=%2Flogin"
                    Icon="@Icons.Material.Filled.Logout">
            Sair
        </MudNavLink>
    </MudNavMenu>

</MudDrawer>

@code {
    private bool _drawerOpen;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}
