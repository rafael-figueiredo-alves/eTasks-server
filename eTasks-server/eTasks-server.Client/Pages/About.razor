@using eTasks_server.Models.Utils

@page "/about"
@attribute [Authorize(Roles = "Admin")]

@rendermode InteractiveAuto
@inherits AboutBase

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight:bold">@Constants.AppTitle</MudText>
    <MudText Typo="Typo.h6" Class="mb-1">Versão: @Constants.ServerVersion</MudText>
    <MudText Typo="Typo.h6" Class="mb-4">Versão da API: @Constants.ApiVersion</MudText>
    <MudTextField Label="Histórico de Versões"
                  Value="@VersionDetails"
                  ReadOnly="true"
                  Variant="Variant.Outlined"
                  Lines="10" />
    <MudText Typo="Typo.subtitle1" Class="mt-4">© @DateTime.UtcNow.Year - @Constants.DeveloperName</MudText>
</MudContainer>

