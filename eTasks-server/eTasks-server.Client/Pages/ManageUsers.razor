@page "/admin/users"
@rendermode InteractiveAuto
@inherits ManageUsersBase

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-6">Gerenciamento de Usuários</MudText>

    <MudDataGrid T="AdminUserDTO" Items="@Users" Loading="@IsLoading" Filterable="true" QuickFilter="@FilterFunc" Hover="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Usuários do Sistema</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Buscar por nome ou e-mail..." Adornment="Adornment.Start" 
                Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <TemplateColumn Title="Usuário" Sortable="false">
                <CellTemplate>
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="mr-3">
                            @if (!string.IsNullOrEmpty(context.Item.PhotoPath))
                            {
                                <MudImage Src="@context.Item.PhotoPath" />
                            }
                            else
                            {
                                @context.Item.Name[0].ToString().ToUpper()
                            }
                        </MudAvatar>
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1">@context.Item.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@context.Item.Email</MudText>
                        </div>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status" Sortable="true">
                <CellTemplate>
                    <div class="d-flex gap-2">
                        @if (context.Item.IsConfirmed)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Confirmado</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">Pendente</MudChip>
                        }

                        @if (context.Item.IsBlocked)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Bloqueado</MudChip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.CreatedAt" Title="Criado em" Format="dd/MM/yyyy HH:mm" />
            <TemplateColumn Sortable="false" Class="d-flex justify-end" HeaderStyle="padding-bottom: 42px;">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="@(() => ToggleBlock(context.Item))" 
                                     Icon="@(context.Item.IsBlocked ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                     IconColor="@(context.Item.IsBlocked ? Color.Success : Color.Error)">
                            @(context.Item.IsBlocked ? "Desbloquear" : "Bloquear Conta")
                        </MudMenuItem>
                        
                        @if (!context.Item.IsConfirmed)
                        {
                            <MudMenuItem OnClick="@(() => ConfirmAccount(context.Item))" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                                Confirmar Conta
                            </MudMenuItem>
                        }
                        
                        <MudMenuItem OnClick="@(() => ResetPassword(context.Item))" Icon="@Icons.Material.Filled.Password">
                            Trocar Senha
                        </MudMenuItem>
                        
                        <MudMenuItem OnClick="@(() => SendResetEmail(context.Item))" Icon="@Icons.Material.Filled.Mail">
                            Enviar Reset por E-mail
                        </MudMenuItem>
                        
                        <MudMenuItem OnClick="@(() => ViewLogs(context.Item))" Icon="@Icons.Material.Filled.History">
                            Ver Log de Logins
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="AdminUserDTO" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

