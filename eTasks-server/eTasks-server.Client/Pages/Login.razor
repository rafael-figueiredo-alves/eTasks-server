@page "/login"
@rendermode InteractiveAuto
@layout EmptyLayout
@using MudBlazor
@using eTasks_server.Models.Utils

<PageTitle>Login</PageTitle>

<div class="login-wrapper">
    <!-- Background decorative elements -->
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-grid"></div>

    <div class="login-container">
        <!-- Card principal -->
        <MudPaper Class="login-card" Elevation="0">

            <!-- Logo Area -->
            <div class="logo-area">
                <div class="logo-placeholder">
                    <img src="/eTasks2.webp" alt="eTasks-server Logo" style="height: 72px; width: auto; object-fit: contain;"  />
                </div>
                <MudText Typo="Typo.h5" Class="brand-name">@Constants.AppTitle</MudText>
                <MudText Typo="Typo.caption" Class="brand-tagline">Bem-vindo de volta</MudText>
            </div>

            <!-- Divisor -->
            <div class="divider-line"></div>

            <!-- Formulário -->
            <div class="form-area">
                <MudText Typo="Typo.h6" Class="form-title">Acesse sua conta</MudText>

                <MudTextField
                    @bind-Value="_email"
                    Label="E-mail"
                    Variant="Variant.Outlined"
                    InputType="InputType.Email"
                    AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                    Adornment="Adornment.Start"
                    AdornmentColor="Color.Primary"
                    Class="login-field"
                    FullWidth="true"
                    Placeholder="seu@email.com" />

                <MudTextField
                    @bind-Value="_password"
                    Label="Senha"
                    Variant="Variant.Outlined"
                    InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                    AdornmentIcon="@Icons.Material.Filled.Lock"
                    Adornment="Adornment.Start"
                    AdornmentColor="Color.Primary"
                    Class="login-field"
                    FullWidth="true"
                    Placeholder="••••••••">
                    <AdornmentEnd>
                        <MudIconButton Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       Color="Color.Default"
                                       OnClick="TogglePassword"
                                       Size="Size.Small"
                                       Class="toggle-password" />
                    </AdornmentEnd>
                </MudTextField>

                <div class="form-options">
                    <MudCheckBox @bind-Value="_rememberMe" Label="Lembrar-me" Color="Color.Primary" Size="Size.Small" Class="remember-check" />
                    <MudCheckBox @bind-Value="_showPassword" Label="Mostrar senha" Size="Size.Small" Color="Color.Primary" Class="remember-check" />
                </div>

                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth="true"
                    Size="Size.Large"
                    Class="login-button"
                    OnClick="HandleLogin"
                    Disabled="_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                        <span>Entrando...</span>
                    }
                    else
                    {
                        <span>Entrar</span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="ml-2" Size="Size.Small" />
                    }
                </MudButton>

                <div class="signup-row">

                </div>
            </div>

        </MudPaper>

        <!-- Rodapé -->
        <div class="login-footer">
            <MudText Typo="Typo.caption" Class="footer-copyright">
                &copy; @DateTime.Now.Year @Constants.AppTitle. Todos os direitos reservados.
            </MudText>
            <div class="footer-dot"></div>
            <MudText Typo="Typo.caption" Class="footer-version">
                @($"v{Constants.ServerVersion}")
            </MudText>
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _rememberMe = false;
    private bool _showPassword = false;
    private bool _isLoading = false;

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task HandleLogin()
    {
        _isLoading = true;
        // Simula chamada à API — substitua pela sua lógica de autenticação
        await Task.Delay(1500);
        _isLoading = false;
        // NavigationManager.NavigateTo("/dashboard");
    }
}

<style>
    /* ───── Reset & base ───── */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0e1a;
        position: relative;
        overflow: hidden;
        font-family: 'Sora', 'Segoe UI', sans-serif;
    }

    /* ───── Background decorativo ───── */
    .bg-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.18;
        pointer-events: none;
    }

    .bg-orb-1 {
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, #5b7cfa 0%, #3a4fd4 60%, transparent 100%);
        top: -120px;
        left: -100px;
        animation: float1 9s ease-in-out infinite;
    }

    .bg-orb-2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, #a259ff 0%, #6c2bd9 60%, transparent 100%);
        bottom: -80px;
        right: -60px;
        animation: float2 11s ease-in-out infinite;
    }

    .bg-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(91, 124, 250, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(91, 124, 250, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    @@keyframes float1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(30px, 20px) scale(1.05); }
    }

    @@keyframes float2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-20px, -30px) scale(1.08); }
    }

    /* ───── Container central ───── */
    .login-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 420px;
        padding: 0 16px;
        animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ───── Card ───── */
    .login-card {
        background: rgba(16, 22, 40, 0.82) !important;
        border: 1px solid rgba(91, 124, 250, 0.18) !important;
        border-radius: 20px !important;
        padding: 40px 36px 32px !important;
        backdrop-filter: blur(24px);
        box-shadow:
            0 0 0 1px rgba(255,255,255,0.04),
            0 24px 64px rgba(0,0,0,0.55),
            0 0 40px rgba(91,124,250,0.08) !important;
    }

    /* ───── Logo ───── */
    .logo-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        margin-bottom: 28px;
    }

    .logo-placeholder {
        position: relative;
        width: 64px;
        height: 64px;
        margin-bottom: 4px;
    }

    /* Substitua .logo-placeholder pelo seu <img> quando tiver o logo */
    .logo-img {
        width: 64px;
        height: auto;
    }

    .logo-icon-outer {
        position: absolute;
        font-size: 64px !important;
        color: #5b7cfa;
        opacity: 0.35;
    }

    .logo-icon-inner {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 28px !important;
        color: #a5b8ff;
    }

    .brand-name {
        color: #e8eeff !important;
        font-weight: 700 !important;
        letter-spacing: 0.02em;
    }

    .brand-tagline {
        color: #6875a0 !important;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-size: 0.68rem !important;
    }

    /* ───── Divisor ───── */
    .divider-line {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(91,124,250,0.3), transparent);
        margin-bottom: 28px;
    }

    /* ───── Formulário ───── */
    .form-title {
        color: #c8d4ff !important;
        font-weight: 600 !important;
        margin-bottom: 22px !important;
    }

    .login-field {
        margin-bottom: 16px !important;
    }

    /* Sobrescreve estilos MudBlazor para tema escuro */
    .login-field .mud-input-outlined .mud-input-outlined-border {
        border-color: rgba(91, 124, 250, 0.25) !important;
        border-radius: 10px !important;
    }

    .login-field .mud-input-outlined:hover .mud-input-outlined-border {
        border-color: rgba(91, 124, 250, 0.55) !important;
    }

    .login-field .mud-input-outlined.mud-input-focused .mud-input-outlined-border {
        border-color: #5b7cfa !important;
    }

    .login-field label,
    .login-field input,
    .login-field .mud-input-adornment {
        color: #a5b4d4 !important;
    }

    .toggle-password {
        color: #6875a0 !important;
    }

    /* ───── Opções abaixo dos campos ───── */
    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .remember-check {
        color: #6875a0 !important;
        font-size: 0.82rem;
    }

    .forgot-link {
        color: #7b96ff !important;
        font-size: 0.82rem !important;
        text-decoration: none !important;
        transition: color 0.2s;
    }

    .forgot-link:hover {
        color: #a5b8ff !important;
    }

    /* ───── Botão principal ───── */
    .login-button {
        background: linear-gradient(135deg, #4a6cf7 0%, #7c3aed 100%) !important;
        border-radius: 10px !important;
        height: 50px !important;
        font-size: 0.95rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.03em !important;
        text-transform: none !important;
        box-shadow: 0 4px 20px rgba(91, 124, 250, 0.35) !important;
        transition: box-shadow 0.25s, transform 0.2s !important;
    }

    .login-button:hover:not(:disabled) {
        box-shadow: 0 6px 28px rgba(91, 124, 250, 0.55) !important;
        transform: translateY(-1px);
    }

    .login-button:active:not(:disabled) {
        transform: translateY(0);
    }

    /* ───── Cadastro ───── */
    .signup-row {
        text-align: center;
        margin-top: 20px;
    }

    .signup-text {
        color: #5c6a8a !important;
    }

    .signup-link {
        color: #7b96ff !important;
        font-weight: 600 !important;
        text-decoration: none !important;
        margin-left: 4px;
    }

    .signup-link:hover {
        color: #a5b8ff !important;
    }

    /* ───── Rodapé ───── */
    .login-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
        padding-bottom: 8px;
    }

    .footer-copyright,
    .footer-version {
        color: #3d4d70 !important;
        font-size: 0.72rem !important;
    }

    .footer-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #3d4d70;
    }
</style>
