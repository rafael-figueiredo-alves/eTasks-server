@rendermode InteractiveAuto
@inherits ConfirmDialogBase

<MudDialog Class="confirm-dialog">
    <TitleContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pt-4 pb-2">
            <div class="confirm-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline"
                         Color="Color.Warning"
                         Style="font-size: 3.5rem;" />
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;">
                @Title
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Align="Align.Center" Class="px-4" Color="Color.Default">
            @Message
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="w-100 pb-3">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Large"
                       Style="min-width: 130px; border-radius: 8px;"
                       OnClick="Cancel">
                Cancelar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Size="Size.Large"
                       Style="min-width: 130px; border-radius: 8px;"
                       OnClick="Confirm">
                Confirmar
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

<style>

</style>
