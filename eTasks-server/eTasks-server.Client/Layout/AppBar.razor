@rendermode InteractiveAuto
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject eTasks_server.Client.Services.Interfaces.IAuthServices AuthServices

<MudAppBar Elevation="3">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleDrawer" />

    <MudText Typo="Typo.h6">eTasks Server</MudText>

    <MudSpacer />
    
    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/docs"))">
        Docs
    </MudButton>

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               OnClick="@(() => NavigateTo("/about"))">
        Sobre
    </MudButton>
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen"
           Elevation="1"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           Height="100vh"
           Width="350px">

    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="pa-4">
            eTasks Server
        </MudText>

        <MudDivider />

        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Início
        </MudNavLink>

        <MudNavLink Href="/version"
                    Icon="@Icons.Material.Filled.Info">
            Gerenciar versionamento do App
        </MudNavLink>

        <MudNavLink Href="/admin/users"
                    Icon="@Icons.Material.Filled.People">
            Gerenciar Usuários
        </MudNavLink>

        <MudDivider Class="my-2" />

        <MudNavLink Href="#"
                    Icon="@Icons.Material.Filled.Logout"
                    OnClick="HandleLogout">
            Sair
        </MudNavLink>
    </MudNavMenu>

</MudDrawer>

@code {
    private bool _drawerOpen = false;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private async Task HandleLogout()
    {
        _drawerOpen = false;
        await AuthServices.LogoutAsync();
        Snackbar.Add("Sessão encerrada com sucesso.", Severity.Info);
        Navigation.NavigateTo("/login", replace: true);
    }
}
