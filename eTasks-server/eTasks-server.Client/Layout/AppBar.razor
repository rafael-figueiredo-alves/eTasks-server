@rendermode InteractiveAuto

<MudAppBar Elevation="1" Color="Color.Info">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleDrawer" />

    <MudText Typo="Typo.h6">eTasks Server</MudText>

    <MudSpacer />

    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               Href="https://learn.microsoft.com/aspnet/core/"
               Target="_blank">
        About
    </MudButton>
</MudAppBar>

<!-- Menu lateral -->
<MudDrawer @bind-Open="_drawerOpen"
           Elevation="1"
           Variant="DrawerVariant.Temporary"
           Overlay="true" Height="100vh">

    <MudNavMenu>

        <!-- Título / Logo -->
        <MudText Typo="Typo.h6" Class="pa-4">
            eTasks-server
        </MudText>

        <MudDivider />

        <!-- Links -->
        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Início
        </MudNavLink>

        <MudNavLink Href="/version"
                    Icon="@Icons.Material.Filled.Info">
            Versão
        </MudNavLink>

    </MudNavMenu>

</MudDrawer>

@code {
    private bool _drawerOpen = false;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        Console.WriteLine($"Drawer is now {(_drawerOpen ? "open" : "closed")}");
    }
}
